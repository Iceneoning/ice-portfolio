---
import { Image } from 'astro:assets';
import settlement from '../assets/atelier/winter-settlement.png';
import archive from '../assets/atelier/winter-archive.png';
interface Props { warm?: boolean; wide?: boolean; }
const { warm = false, wide = false } = Astro.props;
---
<Image src={warm ? archive : settlement} alt="" aria-hidden="true" class="portfolio-artwork" widths={[480, 800, 1200]} sizes={wide ? '(max-width: 820px) calc(100vw - 40px), 90vw' : '(max-width: 700px) calc(100vw - 40px), 50vw'} format="webp" quality={82} loading="lazy" />
