---
import '../styles/winter.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; home?: boolean; edition?: string; }
const { title, description, home = false, edition } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f8f7f3" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/visuals/ice-mark.svg" />
    <script is:inline>
      document.documentElement.classList.add('js-images');
      document.addEventListener('DOMContentLoaded', () => {
        for (const image of document.querySelectorAll('img[data-progressive]')) {
          const show = () => image.classList.add('image-ready');
          if (image.decode) image.decode().then(show, show);
          else if (image.complete) show();
          else {
            image.addEventListener('load', show, { once: true });
            image.addEventListener('error', show, { once: true });
          }
        }
      }, { once: true });
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a href="#main" class="skip">跳到主要内容</a>
    <Header home={home} edition={edition} />
    <slot />
    <Footer home={home} />
  </body>
</html>
